# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection
# Order/payment transactions require MongoDB as a replica set or Atlas.
# For local MongoDB, start mongod with --replSet rs0 and initialize the replica set once.
MONGO_URI=mongodb://127.0.0.1:27017/water_supply_db?replicaSet=rs0

# JWT Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this 32-byte key (64 hex characters) backed up; losing it makes stored Razorpay secrets unreadable.
# After setting it for an existing database, run `npm run migrate:razorpay-secrets` from backend once.
RAZORPAY_SECRET_ENCRYPTION_KEY=replace_with_64_hex_characters

# Firebase Admin SDK Credentials (JSON Service Account fields)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# Email / SMTP Settings (For Password Reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=dummy_user
SMTP_PASSWORD=dummy_pass
FROM_NAME="Water Supply Management"
FROM_EMAIL="noreply@watersupply.com"
